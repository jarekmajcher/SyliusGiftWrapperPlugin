{% import "@SyliusShop/Common/Macro/money.html.twig" as money %}

{% if cart.hasGiftWraps %}
    <tr>
        <td colspan="6" class="center aligned">
            <h3 class="ui header"><i class="gift icon"></i>{{ 'jarekmajcher_sylius_gift_wrapper_plugin.ui.your_gift_wraps'|trans }}:</h3>
        </td>
    </tr>

    {% for giftWrap in cart.giftWraps %}

        {% set giftWrapMethod = giftWrap.giftWrapMethod %}

        {% if giftWrapMethod.getMainImage() %}
            {% set thumb = giftWrapMethod.getMainImage().path|imagine_filter('sylius_shop_product_thumbnail') %}
        {% else %}
            {% set thumb = asset('build/shop/images/200x200.png', 'shop') %}
        {% endif %}

        <tr>
            <td class="single line">
                <div class="ui header">
                    <img src="{{ thumb }}" alt="{{ giftWrapMethod.translation.name }}" class="ui bordered image">
                    <div class="content" style="width: calc(100% - 115px);">
                        <div class="sylius-product-name">{{ giftWrap.giftWrapMethod.translation.name }}</div>
                        <div class="sub header" style="margin-bottom: 10px; white-space: wrap;">
                            <strong>{{ 'jarekmajcher_sylius_gift_wrapper_plugin.ui.dedication'|trans }}:</strong><br>
                            {{ giftWrap.dedication|default('sylius.ui.empty'|trans) }}
                        </div>
                        <div class="sub header" style="margin-bottom: 10px; white-space: wrap;">
                            <strong>{{ 'jarekmajcher_sylius_gift_wrapper_plugin.ui.instruction'|trans }}:</strong><br>
                            {{ giftWrap.instruction|default('sylius.ui.empty'|trans) }}
                        </div>
                    </div>
                </div>
            </td>
            <td class="right aligned">
                <span class="sylius-unit-price">{{ money.convertAndFormat(giftWrap.unitPrice) }}</span>
            </td>
            <td class="center aligned">
                <span class="sylius-quantity ui form">1</span>
            </td>
            <td class="center aligned">
                <a href="{{ path('jarekmajcher_gift_wrapper_shop_gift_wrap_remove', {id: giftWrap.id}) }}" class="ui circular icon button sylius-cart-remove-button"><i class="remove icon"></i></a>
            </td>
            <td class="right aligned">
                <span class="sylius-total">{{ money.convertAndFormat(giftWrap.unitPrice) }}</span>
            </td>
        </tr>
    {% endfor %}
{% endif %}
