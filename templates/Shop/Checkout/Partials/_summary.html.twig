{% import "@SyliusShop/Common/Macro/money.html.twig" as money %}

{% if order.hasGiftWraps() %}
    {% set giftWrapsSubtotal = order.getGiftWrapsTotal() %}

    <tr>
        <td colspan="1">
            <strong>{{ 'jarekmajcher_sylius_gift_wrapper_plugin.ui.gift_wraps_total'|trans }}:</strong>
        </td>
        <td colspan="2" class="right aligned">
            {{ money.convertAndFormat(giftWrapsSubtotal) }}
        </td>
    </tr>
{% endif %}
