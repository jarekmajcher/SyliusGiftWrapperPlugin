{% import "@SyliusShop/Common/Macro/money.html.twig" as money %}

{% if order.hasGiftWraps() %}
    {% set giftWrapsSubtotal = order.getGiftWrapsTotal() %}

    <tr>
        <th colspan="4" class="right aligned">
            {{ 'jarekmajcher_sylius_gift_wrapper_plugin.ui.gift_wraps_total'|trans }}: {{ money.convertAndFormat(giftWrapsSubtotal) }}
        </th>
    </tr>
{% endif %}


